# Copy this file to .env.production and replace every example secret.
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Credentials containing URL-special characters must be percent-encoded here.
DATABASE_URL=postgresql://chat:replace-with-a-long-random-password@postgres:5432/chat
REDIS_URL=redis://redis:6379

APP_REPLICAS=2
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_PORT=3000

# The admin service is loopback-only by default. Put it behind a VPN or an
# identity-aware proxy instead of changing this to a public address.
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=3001
ADMIN_SESSION_TTL_HOURS=8

# Optional publishable key used when an embed does not specify data-site-key.
DEFAULT_WIDGET_SITE_KEY=
