{
  "name": "yapping-frog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "build": "npm run build:admin && npm run build:tenant && npm run build:widget",
    "build:admin": "vite build --config frontend/admin/vite.config.ts",
    "build:tenant": "vite build --config frontend/tenant/vite.config.ts",
    "build:widget": "vite build --config frontend/widget/vite.config.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "dev": "npm run build:admin && node --env-file-if-exists=.env --watch src/server.js",
    "dev:admin": "vite --config frontend/admin/vite.config.ts",
    "dev:tenant": "vite --config frontend/tenant/vite.config.ts",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "npm run build:admin && npm run build:tenant && node --test",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "redis": "^5.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
